# Target Jetson/ARM64 runtime. The base image must already contain the
# matching Python, CUDA, TensorRT, PyTorch, and Ultralytics runtime.
BASE_IMAGE=duy-yolo-pytorch:jetpack6
DOCKER_PLATFORM=linux/arm64
RUNTIME_TAG=duy-deploy-web:jetpack6

