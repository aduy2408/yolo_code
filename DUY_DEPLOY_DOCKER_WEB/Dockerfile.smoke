FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    DUY_WEB_REGISTRY=/config/models.json \
    DUY_WEB_MODEL_ROOT=/models \
    DUY_WEB_OUTPUT_ROOT=/tmp/duy_deploy_outputs \
    DUY_WEB_PRELOAD_MODELS=0

WORKDIR /app
COPY requirements-web.txt /tmp/requirements-web.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements-web.txt
COPY app /app/app
COPY web /app/web
COPY models.smoke.json /config/models.json

EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=2)"
ENTRYPOINT ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
